# Copy to .env.local for local development.
#
# THIS REPOSITORY IS PUBLIC. Never put a real value in this file, or in any
# other committed file. Real values live only in the Netlify dashboard:
# Site configuration -> Environment variables.
#
# Generate both admin secrets with:
#   node scripts/gen-admin-secrets.mjs
# It prompts for a password with no echo and writes .env.admin.local, printing
# nothing. Copy the two lines from there into Netlify.

# Base64 of an argon2id hash of the admin password. Never the password itself.
#
# Base64, not the raw hash: .env files run dotenv-expand, which eats every
# $-sign, and an argon2 hash is `$argon2id$v=19$m=...`. No quoting survives it.
# The generator writes the right form; copy it verbatim.
ADMIN_PASSWORD_HASH=

# 32 random bytes, base64. Signs the admin session JWT.
AUTH_SECRET=

# The content store is Netlify Blobs and needs NO variable here.
#
# Inside a Netlify function the runtime supplies the store's credentials on its
# own. Which stores a deploy uses is fixed at build time from Netlify's CONTEXT
# (see next.config.mjs): production → site-content / site-media, previews and
# branch deploys → staging-*, anything else → local-*.
#
# Locally there is no Blobs store at all unless you start one:
#   npm run blobs:local
# It serves a throwaway copy on your machine and prints the
# NETLIFY_BLOBS_CONTEXT value to start the app with. Nothing local can reach
# the real site's stores: the SDK reads NETLIFY_BLOBS_CONTEXT and nothing else.
#
# Do not put NETLIFY_BLOBS_CONTEXT in this file or in Netlify's UI.

# Optional. Defaults to https://mauri-dev.netlify.app
NEXT_PUBLIC_SITE_URL=

# Optional. The token from Search Console's "HTML tag" verification method —
# the `content` value only, not the whole <meta> tag. Set it in Netlify, verify
# the property, and leave it set: Google re-checks the tag periodically and
# unverifies the property if it disappears.
#
# Unset, no tag is emitted at all, which is the correct state for a preview
# deploy: an empty content attribute is a tag that fails verification rather
# than one that is simply absent.
GOOGLE_SITE_VERIFICATION=

# Password-reset email (optional). Without a key, production says reset by email
# is not configured; previews and local runs write to admin-auth/outbox.json.
# Use a free Resend account opened WITH the recovery address — without a verified
# domain, onboarding@resend.dev only delivers to the account's own address.
RESEND_API_KEY=
# Optional. Default: Mauri-Dev <onboarding@resend.dev>
RESEND_FROM=
# Optional. Where reset links go. Default: baymed000@gmail.com
ADMIN_RECOVERY_EMAIL=
