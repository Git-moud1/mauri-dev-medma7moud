# Copy to .env.local for local development.
#
# THIS REPOSITORY IS PUBLIC. Never put a real value in this file, or in any
# other committed file. Real values live only in the Netlify dashboard:
# Site configuration -> Environment variables.
#
# Generate both admin secrets with:
#   node scripts/gen-admin-secrets.mjs
# It prompts for a password with no echo and writes .env.admin.local, printing
# nothing. Copy the two lines from there into Netlify.

# Base64 of an argon2id hash of the admin password. Never the password itself.
#
# Base64, not the raw hash: .env files run dotenv-expand, which eats every
# $-sign, and an argon2 hash is `$argon2id$v=19$m=...`. No quoting survives it.
# The generator writes the right form; copy it verbatim.
ADMIN_PASSWORD_HASH=

# 32 random bytes, base64. Signs the admin session JWT.
AUTH_SECRET=

# The content store. Both are server-only: no NEXT_PUBLIC_ prefix on either,
# because nothing in a browser ever talks to Supabase — every read and write
# runs in a server action, a route handler, or the prerender.
#
# In Netlify these go in Site configuration -> Environment variables scoped to
# BOTH "Builds" and "Functions". Builds is not optional: the public pages read
# the store during the prerender, and that read failing silently at build time
# is exactly the bug this migration exists to fix.
SUPABASE_URL=

# sb_secret_... — the successor to the legacy service_role key. It BYPASSES Row
# Level Security, so it must never reach a browser, a client component, or this
# file with a real value in it. Mark it as a secret in Netlify.
#
# The publishable key (sb_publishable_...) is not used anywhere in this project
# and does not need to be set.
SUPABASE_SECRET_KEY=

# Local only, and only for scripts/migrate-to-supabase.mjs, which reads the old
# Netlify Blobs store from outside a Netlify runtime. Never set these in
# Netlify itself — inside a Netlify runtime the Blobs client supplies both on
# its own. Delete them once the migration is done and the soak period is over.
#
#   NETLIFY_SITE_ID      Site configuration -> General -> Site ID
#   NETLIFY_AUTH_TOKEN   User settings -> Applications -> Personal access tokens
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=

# Optional. Defaults to https://mauri-dev.netlify.app
NEXT_PUBLIC_SITE_URL=

# Optional. The token from Search Console's "HTML tag" verification method —
# the `content` value only, not the whole <meta> tag. Set it in Netlify, verify
# the property, and leave it set: Google re-checks the tag periodically and
# unverifies the property if it disappears.
#
# Unset, no tag is emitted at all, which is the correct state for a preview
# deploy: an empty content attribute is a tag that fails verification rather
# than one that is simply absent.
GOOGLE_SITE_VERIFICATION=
